{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/img/*", "/*.{svg,png,jpg,webp,ico,txt,xml,json}"]
  },
  "routes": [
    { "route": "/index.htm", "redirect": "/", "statusCode": 301 },
    { "route": "/servizi.htm", "redirect": "/#servizi", "statusCode": 301 },
    { "route": "/dovesiamo.htm", "redirect": "/#dove-siamo", "statusCode": 301 },
    { "route": "/contatti.htm", "redirect": "/#contatti", "statusCode": 301 },
    { "route": "/assets/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/img/*", "headers": { "cache-control": "public, max-age=2592000" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.google.com https://maps.google.com; connect-src 'self'"
  },
  "mimeTypes": { ".webp": "image/webp", ".woff2": "font/woff2" }
}
